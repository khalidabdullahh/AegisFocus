<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="aegis_focus.db" />
        <!-- Not backed up on purpose: aegis_auth_prefs.xml holds the sign-in tokens -->
        <include domain="sharedpref" path="aegis_settings.xml" />
        <include domain="sharedpref" path="aegis_productivity.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="aegis_focus.db" />
        <!-- Not backed up on purpose: aegis_auth_prefs.xml holds the sign-in tokens -->
        <include domain="sharedpref" path="aegis_settings.xml" />
        <include domain="sharedpref" path="aegis_productivity.xml" />
    </device-transfer>
</data-extraction-rules>
